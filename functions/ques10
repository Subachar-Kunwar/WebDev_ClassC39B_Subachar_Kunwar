
const add = (a, b) => {
    return a + b;
}

const subtract = (a, b) => {
    return a - b;
}

const multiply = (a, b) => {
    return a * b;
}

const divide = (a, b) => {
    if (b === 0) {
        return "Cannot divide by zero";
    }
    return a / b;
}

const calculate = (a, b, operationCallback) => {
    console.log("....Processing");
    console.log(`Result: ${operationCallback(a, b)}`);
}

calculate(20, 10, add);
calculate(20, 10, subtract);
calculate(20, 10, multiply);
calculate(20, 10, divide);
